# MMMC View Definition File for Cadence Innovus
create_library_set -name slow_lib -timing {libs/gsclib045_ss.lib}
create_library_set -name fast_lib -timing {libs/gsclib045_ff.lib}

create_constraint_mode -name func_sdc -sdc_files {inputs/alu_sdc.sdc}

create_delay_corner -name slow_corner -library_set slow_lib
create_delay_corner -name fast_corner -library_set fast_lib

create_analysis_view -name func_ss -delay_corner slow_corner -constraint_mode func_sdc
create_analysis_view -name func_ff -delay_corner fast_corner -constraint_mode func_sdc

set_analysis_view -setup {func_ss} -hold {func_ff}
